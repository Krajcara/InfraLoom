# ── InfraLoom environment configuration ──────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit the real .env file.

NODE_ENV=production

# Port the application listens on
APP_PORT=3000

# JWT signing secret — generate with: openssl rand -hex 64
APP_SECRET=changeme_generate_a_long_random_string

# Path to the SQLCipher-encrypted database file
DB_PATH=./data/infraloom.db

# SQLCipher encryption key — generate with: openssl rand -hex 32
# WARNING: losing this key means losing access to all data. Back it up securely.
DB_ENCRYPTION_KEY=changeme_generate_a_long_random_string

# Optional: GitHub token, only needed if the repo is private
GITHUB_TOKEN=
