# ── InfraLoom environment configuration ──────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit the real .env file.

NODE_ENV=production

# Port the application listens on
APP_PORT=3000

# JWT signing secret — generate with: openssl rand -hex 64
APP_SECRET=changeme_generate_a_long_random_string

# Path to the SQLCipher-encrypted database file
DB_PATH=./data/infraloom.db

# SQLCipher encryption key — generate with: openssl rand -hex 32
# WARNING: losing this key means losing access to all data. Back it up securely.
DB_ENCRYPTION_KEY=changeme_generate_a_long_random_string

# Backup encryption password — protects the .env copy bundled into each
# backup ZIP (the database file inside is already SQLCipher-encrypted with
# DB_ENCRYPTION_KEY above; this password protects that key itself when it
# travels inside a backup). Generate with: openssl rand -hex 32
# WARNING: store this separately from your backups (e.g. a password
# manager) — a backup ZIP without this password cannot be decrypted, by
# design. Losing it means your backups are unrecoverable.
BACKUP_ENCRYPTION_PASSWORD=changeme_generate_a_long_random_string

# Optional: GitHub token, only needed if the repo is private
GITHUB_TOKEN=
